generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  phone     String?
  role      String    @default("CUSTOMER") // CUSTOMER, ADMIN, STAFF
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   ProductReview[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  street     String
  apartment  String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  label      String   @default("HOME") // HOME, WORK, OTHER
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  icon        String?
  isFeatured  Boolean    @default(false)
  order       Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  description       String
  shortDescription  String?
  price             Float
  compareAtPrice    Float?
  costPrice         Float?
  sku               String?         @unique
  barcode           String?
  stock             Int             @default(0)
  lowStockThreshold Int             @default(5)
  unit              String          @default("1 piece") // "500g", "1 kg", "Pack of 2", etc.
  isFeatured        Boolean         @default(false)
  isDailyDeal       Boolean         @default(false)
  dealEndsAt        DateTime?
  images            String          // Stored as JSON string array e.g. '["url1", "url2"]'
  rating            Float           @default(5.0)
  numReviews        Int             @default(0)
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  reviews           ProductReview[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  rating     Int      @default(5)
  comment    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String      // Stored as JSON string representation of address
  deliverySlot    String?
  notes           String?
  items           OrderItem[]
  subtotal        Float
  deliveryFee     Float       @default(0)
  discountAmount  Float       @default(0)
  couponCode      String?
  total           Float
  paymentMethod   String      @default("COD") // COD, ONLINE_UPI, ONLINE_CARD, ONLINE_NETBANKING
  paymentStatus   String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  orderStatus     String      @default("PENDING") // PENDING, CONFIRMED, PACKED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  trackingHistory String      @default("[]") // JSON string array of { status, timestamp, note }
  invoiceNumber   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String?
  price        Float
  quantity     Int
  unit         String?
  total        Float
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  discountType     String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue    Float
  minOrderAmount   Float     @default(0)
  maxDiscountAmount Float?
  usageLimit       Int?
  usageCount       Int       @default(0)
  expiresAt        DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  tag        String?
  image      String
  link       String    @default("/products")
  buttonText String    @default("Shop Now")
  isActive   Boolean   @default(true)
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
}

model StoreSetting {
  id               String   @id @default("default")
  shopName         String   @default("FreshMart Local Shop")
  phone            String   @default("+91 73804 92118")
  whatsapp         String   @default("+917380492118")
  email            String   @default("contact@freshmart.local")
  address          String   @default("Main Market, Shop #12, Near Clock Tower, City Center")
  currency         String   @default("₹")
  freeDeliveryMin  Float    @default(499)
  deliveryFee      Float    @default(40)
  announcement     String?  @default("🎉 Special Offer: Free delivery on orders above ₹499! Use code WELCOME10 for 10% OFF")
  openHours        String?  @default("Mon - Sun: 7:00 AM - 10:00 PM")
  updatedAt        DateTime @updatedAt
}
